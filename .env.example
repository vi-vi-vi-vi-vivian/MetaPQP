OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TEXT_MODEL_PROVIDER=openrouter
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=
VISION_MODEL_PROVIDER=gemini
VISION_MODEL_BASE_URL=
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=
MODEL_HTTPS_PROXY=
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BACKOFF_SECONDS=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_IMAGE_COMPRESS_THRESHOLD_BYTES=250000
GEMINI_IMAGE_MAX_PIXELS=1800000
GEMINI_IMAGE_JPEG_QUALITY=82
VISUAL_AUDIT_ENABLED=true
VISUAL_MODEL_PROFILE=default-vision
# Full-page visual coverage is always enabled; this only limits images per request.
VISUAL_MODEL_MAX_IMAGES_PER_CALL=5
GEMINI_TIMEOUT_SECONDS=180
GEMINI_FALLBACK_PROBE_TIMEOUT_SECONDS=45
WORKFLOW_TIMEOUT_SECONDS=300
OPENJIUWEN_LOG_LEVEL=WARNING
OPENJIUWEN_CONSOLE_LOGS=false

AUTH_ACCOUNT_CONFIG_PATH=config/auth/account.local.yaml
HUAWEICLOUD_LOGIN_HEADLESS=true

MCP_ENABLED=false
MCP_SERVER_URL=
